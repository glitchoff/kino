{
  "name": "@glitchoff/kino",
  "version": "0.3.6",
  "description": "Compile declarative JSON video compositions to FFmpeg",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kino": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "studio": "tsx watch studio/server.ts"
  },
  "keywords": [
    "ffmpeg",
    "video",
    "compiler",
    "timeline",
    "render"
  ],
  "author": "glitchoff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glitchoff/kino.git"
  },
  "dependencies": {
    "@hono/node-server": "^1.8.2",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.0.9"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
