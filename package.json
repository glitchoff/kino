{
  "name": "@glitchoff/kino",
  "version": "1.0.0",
  "description": "Compile declarative JSON video compositions to FFmpeg",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kino": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "scripts",
    "studio/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsup && pnpm studio:build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "studio": "tsx watch studio/server.ts",
    "studio:dev": "vite studio",
    "studio:build": "vite build studio",
    "postinstall": "node scripts/install-ffmpeg.mjs && node scripts/install-browser.mjs"
  },
  "keywords": [
    "ffmpeg",
    "video",
    "compiler",
    "timeline",
    "render"
  ],
  "author": "glitchoff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glitchoff/kino.git"
  },
  "dependencies": {
    "@hono/node-server": "^1.8.2",
    "adm-zip": "^0.6.0",
    "ffmpeg-static": "^5.3.0",
    "puppeteer": "^24.43.1",
    "hono": "^4.0.9",
    "tar": "^7.5.22",
    "xz-decompress": "^0.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vite": "^8.2.0",
    "vitest": "^1.4.0"
  }
}
