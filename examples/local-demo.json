{
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "audio": [
    {
      "src": "./examples/assets/lofi-track.mp3",
      "volume": 0.8,
      "fadeIn": 2,
      "fadeOut": 3
    }
  ],
  "scenes": [
    {
      "id": "scene-1-earth",
      "duration": 12,
      "background": {
        "type": "image",
        "src": "./examples/assets/bg-earth.jpg"
      },
      "elements": [
        {
          "type": "text",
          "content": "KINO LOCAL HIGH-SPEED SHOWCASE",
          "fontSize": 84,
          "fontColor": "#ffffff",
          "box": true,
          "boxColor": "black@0.6",
          "boxPadding": 24,
          "x": "center",
          "y": "(h-text_h)/2-60",
          "startAt": 1,
          "duration": 10,
          "sfx": {
            "src": "./examples/assets/click-sfx.mp3",
            "volume": 0.9
          }
        },
        {
          "type": "text",
          "content": "Zero Network Latency — Local SSD Media Processing",
          "fontSize": 38,
          "fontColor": "#38bdf8",
          "x": "center",
          "y": "(h-text_h)/2+80",
          "startAt": 3,
          "duration": 8
        }
      ]
    },
    {
      "id": "scene-2-space",
      "duration": 13,
      "background": {
        "type": "image",
        "src": "./examples/assets/bg-space.jpg"
      },
      "elements": [
        {
          "type": "image",
          "src": "./examples/assets/logo-badge.png",
          "width": 320,
          "x": "center",
          "y": "(main_h-overlay_h)/2-60",
          "startAt": 2,
          "duration": 10
        },
        {
          "type": "text",
          "content": "Blazing Fast HardwareNVENC GPU Encoding",
          "fontSize": 44,
          "fontColor": "#ffffff",
          "box": true,
          "boxColor": "black@0.7",
          "boxPadding": 20,
          "x": "center",
          "y": "(h-text_h)/2+200",
          "startAt": 3,
          "duration": 9
        }
      ]
    },
    {
      "id": "scene-3-outro",
      "duration": 10,
      "background": {
        "type": "gradient",
        "from": "#030712",
        "to": "#1e1b4b"
      },
      "elements": [
        {
          "type": "text",
          "content": "Render Complete in Seconds",
          "fontSize": 56,
          "fontColor": "#34d399",
          "box": true,
          "boxColor": "black@0.5",
          "boxPadding": 18,
          "x": "center",
          "y": "(h-text_h)/2-40",
          "startAt": 1,
          "duration": 8,
          "sfx": "./examples/assets/click-sfx.mp3"
        }
      ]
    }
  ]
}
