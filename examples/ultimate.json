        },
        {
          "type": "image",
          "src": "https://cataas.com/cat?width=300",
          "width": 300,
          "x": "center",
          "y": "(main_h-overlay_h)/2+180",
          "startTime": 2.5,
          "duration": 6.5,
          "zIndex": 2,
          "animation": {
            "scale": { "from": 0.5, "to": 1, "duration": 0.8, "easing": "easeIn" }
          }
        }
      ]
    },
    {
      "id": "outro-solid",
      "startTime": 26,
      "duration": 8,
      "background": {
        "type": "color",
        "value": "#052e16"
      },
      "elements": [
        {
          "type": "text",
          "content": "KINO — fully utilized ✓",
          "fontSize": 96,
          "fontColor": "#34d399",
          "x": "center",
          "y": "(h-text_h)/2-80",
          "startTime": 0.5,
          "duration": 7,
          "zIndex": 1,
          "sfx": {
            "src": "./examples/assets/click-sfx.mp3",
            "volume": 0.8
          },
          "animation": {
            "opacity": { "from": 0, "to": 1, "duration": 0.5, "easing": "easeOut" },
            "scale": { "from": 0.9, "to": 1, "duration": 0.5 }
          }
        },
        {
          "type": "text",
          "content": "34s | 4 overlapping scenes | video+gradient+image+color backgrounds | dual audio amix | custom font | zIndex | animations",
          "fontSize": 34,
          "fontColor": "#d1fae5",
          "x": "center",
          "y": "bottom-90",
          "startTime": 2,
          "duration": 5.5,
          "zIndex": 0,
          "animation": {
            "x": { "from": 400, "to": 0, "duration": 0.6, "easing": "easeOut" },
            "opacity": { "from": 0, "to": 1, "duration": 0.6 }
          }
        }
