{
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "timeline": "absolute",
  "audio": [
    {
      "src": "./examples/assets/lofi-track.mp3",
      "volume": 0.5,
      "offset": 5,
      "fadeIn": 2,
      "fadeOut": 4
    },
    {
      "src": "./examples/assets/click-sfx.mp3",
      "startTime": 12,
      "duration": 6,
      "loop": true,
      "volume": 0.4
    }
  ],
  "scenes": [
    {
      "id": "intro-video-bg",
      "startTime": 0,
      "duration": 8,
      "background": {
        "type": "video",
        "src": "./examples/assets/test-clip.mp4",
        "loop": true
      },
      "elements": [
        {
          "type": "text",
          "content": "It's KINO — the Cat's Meow! (100% cat-pilled)",
          "fontSize": 88,
          "fontColor": "#ffffff",
          "fontFile": "./examples/assets/arial-bold.ttf",
          "box": true,
          "boxColor": "black@0.65",
          "boxPadding": 28,
          "x": "center",
          "y": "(h-text_h)/2-220",
          "startTime": 0.5,
          "duration": 7,
          "zIndex": 1,
          "sfx": {
            "src": "./examples/assets/click-sfx.mp3",
            "volume": 0.9
          },
          "animation": {
            "opacity": { "from": 0, "to": 1, "duration": 0.5, "easing": "easeOut" },
            "scale": { "from": 0.85, "to": 1, "duration": 0.6, "easing": "easeInOut" }
          }
        },
        {
          "type": "text",
          "content": "Video loop background\nAbsolute timeline overlap\n'apostrophes' : colons \\ backslashes",
          "fontSize": 40,
          "fontColor": "#facc15",
          "x": "center",
          "y": "bottom-120",
          "startTime": 1,
          "duration": 6.5,
          "zIndex": 0,
          "animation": {
            "x": { "from": -500, "to": 0, "duration": 0.8, "easing": "easeOut" },
            "opacity": { "from": 0, "to": 1, "duration": 0.8, "delay": 0.3 }
          }
        }
      ]
    },
    {
      "id": "cats-gallery",
      "startTime": 6,
      "duration": 14,
      "background": {
        "type": "gradient",
        "from": "#0f172a",
        "to": "#7c3aed",
        "direction": "horizontal"
      },
      "elements": [
        {
          "type": "image",
          "src": "https://cataas.com/cat?width=400&height=400",
          "width": 400,
          "x": "(main_w-overlay_w)/2-560",
          "y": "(main_h-overlay_h)/2-40",
          "startTime": 1,
          "duration": 12,
          "zIndex": 3,
          "sfx": "./examples/assets/click-sfx.mp3",
          "animation": {
            "opacity": { "from": 0, "to": 1, "duration": 0.5, "easing": "easeOut" }
          }
        },
        {
          "type": "image",
          "src": "https://cataas.com/cat?width=500",
          "width": 500,
          "x": "(main_w-overlay_w)/2",
          "y": "(main_h-overlay_h)/2-40",
          "startTime": 3,
          "duration": 10,
          "zIndex": 2,
          "animation": {
            "scale": { "from": 0.6, "to": 1, "duration": 0.7, "easing": "easeInOut" },
            "opacity": { "from": 0, "to": 1, "duration": 0.7 }
          }
        },
        {
          "type": "image",
          "src": "https://cataas.com/cat?width=360",
          "height": 360,
          "x": "(main_w-overlay_w)/2+560",
          "y": "(main_h-overlay_h)/2-40",
