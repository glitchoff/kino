      "elements": [
        {
          "type": "text",
          "content": "Image Background — Absolute Timeline Layer 2",
          "fontSize": 62,
          "fontColor": "#ffffff",
          "box": true,
          "boxColor": "black@0.7",
          "boxPadding": 22,
          "x": "center",
          "y": "top-70",
          "startTime": 1,
          "duration": 8,
          "zIndex": 1,
          "sfx": "./examples/assets/click-sfx.mp3",
          "animation": {
            "opacity": { "from": 0, "to": 1, "duration": 0.4 },
            "x": { "from": -300, "to": 0, "duration": 0.7, "easing": "easeOut" }
