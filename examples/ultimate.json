            "y": { "from": -80, "to": 0, "duration": 0.6, "easing": "easeOut" },
            "opacity": { "from": 0, "to": 1, "duration": 0.6, "delay": 0.2 }
          }
        },
        {
          "type": "text",
          "content": "Three cats, three cataas fetches, zero zero-config",
          "fontSize": 46,
          "fontColor": "#a5f3fc",
          "box": true,
          "boxColor": "black@0.55",
          "boxPadding": 18,
          "x": "center",
          "y": "(h-text_h)/2+300",
          "startTime": 1.5,
          "duration": 12,
          "zIndex": 4,
          "animation": {
            "opacity": { "from": 0, "to": 1, "duration": 0.4, "easing": "easeInOut" }
          }
        }
      ]
    },
    {
      "id": "cat-crown",
      "startTime": 18,
      "duration": 10,
      "background": {
        "type": "image",
        "src": "https://cataas.com/cat?width=1600"
