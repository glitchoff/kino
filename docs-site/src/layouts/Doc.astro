---
import { getCollection } from "astro:content";

// Sidebar order: index first, then a fixed reading order, then anything new.
const ORDER = ["index", "getting-started", "api-reference", "schema-reference", "studio"];

const entries = await getCollection("docs");
const pages = entries
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title ?? entry.id.replace(/-/g, " "),
  }))
  .sort((a, b) => {
    const ai = ORDER.indexOf(a.id);
    const bi = ORDER.indexOf(b.id);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  });

const { pathname } = Astro.url;
const current = pathname.replace(/\/$/, "").split("/").pop() || "index";

// `BASE_URL` is `/kino` without a trailing slash here, so joining naively gave
// `/kinogetting-started/`. Normalise instead of assuming the shape.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path = "") => `${base}${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title ? `${Astro.props.title} — Kino` : "Kino"}</title>
    <meta name="description" content="Kino — scripting-first video engine for TypeScript." />
    <link rel="icon" href={href("favicon.svg")} />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={href()}>kino</a>
      <span class="tag">scripting-first video engine</span>
    </header>
    <div class="shell">
      <nav class="sidebar">
        {pages.map((page) => (
          <a
            href={href(page.id === "index" ? "" : page.id + "/")}
            aria-current={page.id === current ? "page" : undefined}
          >
            {page.title}
          </a>
        ))}
      </nav>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0d12;
    --panel: #12151c;
    --text: #e6e8ee;
    --muted: #8b93a7;
    --accent: #f5b544;
    --line: #232838;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: dark;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  .topbar {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .brand {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    font-size: 1.15rem;
  }

  .tag {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .shell {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 2.5rem;
    max-width: 78rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    position: sticky;
    top: 4.5rem;
    align-self: start;
  }

  .sidebar a {
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.7rem;
    border-radius: 0.4rem;
    text-transform: capitalize;
  }

  .sidebar a:hover {
    color: var(--text);
    background: var(--panel);
  }

  .sidebar a[aria-current="page"] {
    color: var(--accent);
    background: var(--panel);
  }

  main {
    min-width: 0;
  }

  main h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin-top: 0;
  }

  main h2 {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  main h3 {
    margin-top: 1.75rem;
  }

  main a {
    color: var(--accent);
  }

  main code {
    background: var(--panel);
    padding: 0.15em 0.4em;
    border-radius: 0.3rem;
    font-size: 0.9em;
  }

  main pre {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
  }

  main pre code {
    background: none;
    padding: 0;
  }

  main table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  main th,
  main td {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  main blockquote {
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }

  @media (max-width: 50rem) {
    .shell {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
